<Window x:Class="AndroidPhoneEmulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="Android Phone Emulator"
        Width="430" Height="880"
        MinWidth="120" MinHeight="120"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#05070A"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        SourceInitialized="Window_SourceInitialized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Border x:Name="PhoneFrame"
                Width="430"
                Height="880"
                Background="#080B10"
                BorderBrush="#303744"
                BorderThickness="2"
                CornerRadius="42"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="78" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ClockText"
                               Text="12:00"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#D9DEE8" />
                    <Border Grid.Column="1"
                            Width="245" Height="28"
                            Background="#303744"
                            BorderBrush="#303744"
                            BorderThickness="1"
                            CornerRadius="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Grid>
                            <Ellipse Width="7" Height="7"
                                     Fill="#172235"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="11,0,0,0" />
                            <ComboBox x:Name="SystemImageComboBox"
                                      Margin="23,0,5,0"
                                      Padding="5,0"
                                      Background="#303744"
                                      Foreground="#E7EBF2"
                                      BorderThickness="0"
                                      FontSize="11"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="DisplayText"
                                      IsTextSearchEnabled="False"
                                      SelectionChanged="SystemImageComboBox_SelectionChanged">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton Focusable="False"
                                                          ClickMode="Press"
                                                          Background="{TemplateBinding Background}"
                                                          BorderThickness="0"
                                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="0,13,13,0">
                                                            <Grid>
                                                                <TextBlock Text="{Binding SelectedItem.DisplayText, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                           Foreground="#E7EBF2"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="7,0,23,0" />
                                                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                                      Fill="#B7C0CD"
                                                                      Width="8" Height="4"
                                                                      Stretch="Fill"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,8,0" />
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <Popup x:Name="PART_Popup"
                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   Placement="Bottom"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   PopupAnimation="Fade">
                                                <Border Background="#303744"
                                                        BorderBrush="#485260"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Margin="0,4,0,0"
                                                        Padding="2"
                                                        MinWidth="{TemplateBinding ActualWidth}">
                                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </ComboBox.Template>
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#303744" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#303744" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#263328" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#69F0AE" />
                                </ComboBox.Resources>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#303744" />
                                        <Setter Property="Foreground" Value="#E7EBF2" />
                                        <Setter Property="Padding" Value="10,7" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE921;"
                                ToolTip="Minimize"
                                Style="{StaticResource PhoneTopButton}"
                                Click="MinimizeButton_Click" />
                        <Button Content="&#xE8BB;"
                                ToolTip="Close"
                                Style="{StaticResource PhoneTopButton}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        x:Name="ScreenBorder"
                        Background="#000000"
                        BorderThickness="0"
                        CornerRadius="26"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">
                    <Grid x:Name="ScreenGrid" Background="#000000" ClipToBounds="True">
                        <wfi:WindowsFormsHost x:Name="EmulatorHost"
                                                    Visibility="Collapsed"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                            <wf:Panel x:Name="EmulatorPanel" BackColor="#000000" />
                        </wfi:WindowsFormsHost>

                        <Grid x:Name="IdleScreen" Background="#0D1118">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20">
                                <StackPanel Width="350" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="72" Height="72"
                                            Background="#16241F"
                                            CornerRadius="22"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE7F8;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="35"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="ScreenTitle"
                                               Text="Android Phone"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,18,0,0" />
                                    <TextBlock x:Name="ScreenStatus"
                                               Text="Checking runtime …"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Width="330"
                                               Margin="0,8,0,0" />
                                    <TextBlock x:Name="ImageDescriptionText"
                                               Foreground="#718096"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Width="330"
                                               Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <Button x:Name="StartButton"
                                                Content="Start phone"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="StartButton_Click"
                                                Margin="0,0,6,0" />
                                        <Button x:Name="DownloadImageButton"
                                                Content="Download image"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="DownloadImageButton_Click"
                                                Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="Drop an APK here"
                                               Foreground="#667386"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,0" />
                                </StackPanel>
                            </Viewbox>
                        </Grid>

                        <Border x:Name="DropOverlay"
                                Visibility="Collapsed"
                                Background="#E6121B18"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="3"
                                CornerRadius="25"
                                Margin="4"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="54"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Drop APK"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="The app will be installed and opened"
                                           Foreground="#B8C4D5"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BusyOverlay"
                                Visibility="Collapsed"
                                Background="#E60A0D12"
                                CornerRadius="25"
                                IsHitTestVisible="True">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                                <ProgressBar Width="220" Height="4" IsIndeterminate="True"
                                             Foreground="{StaticResource AccentBrush}" Background="#273141" />
                                <TextBlock x:Name="BusyText"
                                           Text="Starting Android …"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           Margin="0,18,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#0B0F15" CornerRadius="0,0,32,32" Margin="0,8,0,0">
                    <Grid Margin="8,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" ToolTip="Back" Content="&#xE0A6;"
                                Style="{StaticResource PhoneBarButton}" Click="BackButton_Click" />
                        <Button Grid.Column="1" ToolTip="Home" Content="&#xE80F;"
                                Style="{StaticResource PhoneBarButton}" Click="HomeButton_Click" />
                        <Button Grid.Column="2" ToolTip="Recent apps" Content="&#xE7C4;"
                                Style="{StaticResource PhoneBarButton}" Click="RecentsButton_Click" />
                        <Button Grid.Column="3" ToolTip="Rotate the complete phone" Content="&#xE7AD;"
                                Style="{StaticResource PhoneBarButton}" Click="RotateButton_Click" />
                        <Button Grid.Column="4" ToolTip="Volume down" Content="&#xE993;"
                                Style="{StaticResource PhoneBarButton}" Click="VolumeDownButton_Click" />
                        <Button Grid.Column="5" ToolTip="Volume up" Content="&#xE995;"
                                Style="{StaticResource PhoneBarButton}" Click="VolumeUpButton_Click" />
                        <Button Grid.Column="6" ToolTip="Install APK" Content="&#xE896;"
                                Style="{StaticResource PhoneBarButton}" Click="InstallApkButton_Click" />
                        <Button Grid.Column="7" ToolTip="Power" Content="&#xE7E8;"
                                Style="{StaticResource PhoneBarButton}" Click="PowerButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Viewbox>
</Window>
